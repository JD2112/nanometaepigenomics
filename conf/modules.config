/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'NANOPLOT' {
        publishDir = [
            path: { "${params.outdir}/qc/nanoplot" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'DORADO_BASECALL' {
        maxForks   = 1
        publishDir = [
            path: { "${params.outdir}/basecalling/dorado" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PORECHOP_ABI' {
        publishDir = [
            path: { "${params.outdir}/preprocessing/porechop" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FILTLONG' {
        ext.args   = '--min_length 1000 --keep_percent 90'
        publishDir = [
            path: { "${params.outdir}/preprocessing/filtlong" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:DECONTAMINATION:.*' {
        publishDir = [
            path: { "${params.outdir}/decontamination" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'FLYE' {
        ext.args   = '--meta'
        publishDir = [
            path: { "${params.outdir}/assembly/flye" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'GENOMAD_ENDTOEND' {
        publishDir = [
            path: { "${params.outdir}/classification/genomad" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'METABAT2_METABAT2' {
        publishDir = [
            path: { "${params.outdir}/binning/metabat2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'CHECKM2_PREDICT' {
        publishDir = [
            path: { "${params.outdir}/binning/checkm2" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:BINNING_QC_TAXONOMY:MINIMAP2_ALIGN' {
        ext.args   = '-ax map-ont -y'
        ext.args4  = '-T MM,ML'
    }

    withName: 'GTDBTK_CLASSIFYWF' {
        publishDir = [
            path: { "${params.outdir}/taxonomy/gtdbtk" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MODKIT_PILEUP' {
        ext.args   = '--filter-threshold 0.8'
        publishDir = [
            path: { "${params.outdir}/methylation/modkit" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'NANOMOTIF_FIND_MOTIFS' {
        ext.args   = '--threshold_valid_coverage 3'
        publishDir = [
            path: { "${params.outdir}/methylation/nanomotif" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'AMRFINDERPLUS_RUN' {
        publishDir = [
            path: { "${params.outdir}/annotation/amrfinderplus" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'ABRICATE_RUN' {
        ext.args   = '--db vfdb'
        publishDir = [
            path: { "${params.outdir}/annotation/virulence" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'PLASMIDFINDER' {
        publishDir = [
            path: { "${params.outdir}/annotation/plasmidfinder" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'BAKTA_BAKTA' {
        publishDir = [
            path: { "${params.outdir}/annotation/bakta" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MANIFEST_WRITER' {
        publishDir = [
            path: { "${params.outdir}/pipeline_info" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = params.multiqc_title ? "--title \"$params.multiqc_title\"" : ''
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode
        ]
    }

    withName: 'QUARTO_REPORT' {
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode
        ]
    }

    withName: '.*:STAGE_REFERENCES:DOWNLOAD_.*|.*:STAGE_REFERENCES:CHECKM2_DATABASEDOWNLOAD' {
        publishDir = [
            path: { params.db_cache_dir ? "${params.db_cache_dir}" : "${params.outdir}/databases" },
            mode: 'copy'
        ]
    }

}
